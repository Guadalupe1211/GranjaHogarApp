{
  "version": 2,
  "outputDirectory": "appgranja/build",
  "buildCommand": "cd appgranja && npm install && DISABLE_ESLINT_PLUGIN=true npm run build",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "SistemaInventario/wsgi.py"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "SistemaInventario/wsgi.py": {
      "runtime": "python3.12"
    }
  }
}
