{
  "version": 2,
  "builds": [
    {
      "src": "appgranja/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "SistemaInventario/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "SistemaInventario/wsgi.py"
    },
    {
      "src": "/(.*)",
      "dest": "appgranja/build/$1"
    }
  ]
}
